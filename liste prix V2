(async function() {
  var sleep = function(ms) {
    return new Promise(function(resolve) { setTimeout(resolve, ms); });
  };
  var allCards = [];
  var page = 0;
  var totalPages = null;

  // 1. Interface graphique (allégée sans la barre de progression)
  var ui = document.createElement("div");
  ui.id = "wm-scanner-ui";
  Object.assign(ui.style, {
    position: "fixed",
    top: "20px",
    right: "20px",
    zIndex: "999999",
    width: "300px",
    padding: "16px",
    backgroundColor: "rgba(18, 18, 24, 0.95)",
    backdropFilter: "blur(8px)",
    border: "1px solid #334155",
    borderRadius: "12px",
    boxShadow: "0 10px 25px rgba(0, 0, 0, 0.5)",
    fontFamily: "system-ui, -apple-system, sans-serif",
    color: "#f8fafc",
    fontSize: "13px",
    display: "flex",
    flexDirection: "column",
    gap: "8px"
  });

  var title = document.createElement("div");
  title.style.fontWeight = "700";
  title.style.color = "#00d2ff";
  title.textContent = "Scan Collection Complète";
  ui.appendChild(title);

  var statusLabel = document.createElement("div");
  Object.assign(statusLabel.style, {
    fontSize: "12px",
    color: "#e2e8f0",
    whiteSpace: "nowrap",
    overflow: "hidden",
    textOverflow: "ellipsis"
  });
  statusLabel.textContent = "Initialisation...";
  ui.appendChild(statusLabel);

  document.body.appendChild(ui);

  // Nouvelle fonction pour mettre à jour uniquement le texte
  var updateStatus = async function(statusText) {
    statusLabel.textContent = statusText;
    await new Promise(requestAnimationFrame);
  };

  var closeUI = function(delay) {
    setTimeout(function() {
      ui.style.transition = "opacity 0.4s ease";
      ui.style.opacity = "0";
      setTimeout(function() { ui.remove(); }, 400);
    }, delay || 4000);
  };

  // 2. Récupération de l'inventaire complet
  await updateStatus("Lecture de l'inventaire...");

  while (true) {
    try {
      var res = await fetch("/api/my-collection?sort=rarity&page=" + page + "&stats=0");
      if (!res.ok) break;

      var data = await res.json();
      var list = data.collection || [];

      if (totalPages === null && data.totalPages) {
        totalPages = data.totalPages;
      }

      if (list.length === 0) break;

      for (var i = 0; i < list.length; i++) {
        var item = list[i];
        var card = item.card || {};
        
        // Détection du tag
        var hasTag = (item.tag || (item.tags && item.tags.length > 0) || card.tag || (card.tags && card.tags.length > 0)) ? "Oui" : "Non";

        allCards.push({
          id: card.id || item.card_id,
          nom: card.wikipedia_title || "Sans titre",
          rarete: card.rarity || "NC",
          tag: hasTag,
          exemplaires: item.count || 1,
          prixWB: null,
          statut: "En attente"
        });
      }

      page++;
      await updateStatus("Inventaire : page " + page + (totalPages ? " / " + totalPages : "") + " (" + allCards.length + " cartes)");

      if (totalPages && page >= totalPages) break;
      await sleep(40);
    } catch (err) {
      console.error("[WikiMasters] Erreur collection :", err);
      break;
    }
  }

  if (allCards.length === 0) {
    await updateStatus("Aucune carte trouvée.");
    console.log("%c[WikiMasters] Aucune carte trouvée.", "color: #ff5722; font-weight: bold;");
    closeUI(3000);
    return;
  }

  // 3. Récupération des prix moyens du marché
  var batchSize = 25;
  var total = allCards.length;

  for (var j = 0; j < total; j += batchSize) {
    var batch = allCards.slice(j, j + batchSize);

    await Promise.all(
      batch.map(async function(card) {
        if (!card.id) return;
        try {
          var sRes = await fetch("/api/marketplace/cards/" + card.id + "/sales?scope=summary");
          if (sRes.ok) {
            var sales = await sRes.json();
            var summary = sales.summary || {};
            var rarityStats = summary[card.rarete] || Object.values(summary)[0];
            var avg = rarityStats ? rarityStats.average : null;

            if (avg && avg > 0) {
              card.prixWB = Math.round(avg);
              card.statut = card.prixWB + " WB";
            } else {
              card.statut = "Aucune vente";
            }
          } else {
            card.statut = "Pas de données";
          }
        } catch (e) {
          card.statut = "Erreur API";
        }
      })
    );

    var processed = Math.min(j + batchSize, total);
    await updateStatus("Scan des prix marché : " + processed + " / " + total + " cartes");
    await sleep(60);
  }

  // 4. Tri et assignation globale
  allCards.sort(function(a, b) {
    return (b.prixWB || 0) - (a.prixWB || 0);
  });
  window.__CARDS__ = allCards;

  // 5. Génération et téléchargement du CSV
  await updateStatus("Génération du fichier CSV...");

  var lines = [];
  lines.push(["Rareté", "Nom", "Tag", "Exemplaires", "Prix Moyen (WB)", "Valeur Totale (WB)", "Statut", "ID"]);

  for (var k = 0; k < allCards.length; k++) {
    var c = allCards[k];
    var valTotale = (c.prixWB !== null && c.prixWB !== undefined) ? (c.prixWB * c.exemplaires) : "";
    lines.push([
      c.rarete,
      c.nom,
      c.tag,
      c.exemplaires,
      c.prixWB !== null && c.prixWB !== undefined ? c.prixWB : "",
      valTotale,
      c.statut,
      c.id
    ]);
  }

  var csvContent = "\uFEFF" + lines.map(function(row) {
    return row.map(function(cell) {
      return '"' + String(cell).replace(/"/g, '""') + '"';
    }).join(";");
  }).join("\r\n");

  var blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
  var url = URL.createObjectURL(blob);
  var link = document.createElement("a");
  link.href = url;
  link.download = "wikimasters_collection_" + new Date().toISOString().slice(0, 10) + ".csv";
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  URL.revokeObjectURL(url);

  await updateStatus("Téléchargement terminé !");
  console.log("%c[WikiMasters] ✅ " + allCards.length + " cartes exportées avec succès dans le fichier CSV.", "color: #00ff88; font-weight: bold;");
  closeUI(5000);
})();
