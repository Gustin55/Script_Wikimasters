(async () => {
  const sleep = ms => new Promise(r => setTimeout(r, ms));
  const allCards = [];
  let page = 0;
  let hasMore = true;

  console.log("%c[WikiMasters] 1/3 Récupération de l'inventaire...", "color: #00d2ff; font-weight: bold;");

  while (hasMore) {
    try {
      const res = await fetch('/api/my-collection?sort=rarity&page=' + page + '&stats=0');
      if (!res.ok) break;

      const data = await res.json();
      const list = data.collection || [];
      if (list.length === 0) {
        hasMore = false;
        break;
      }

      for (const item of list) {
        const card = item.card || {};
        allCards.push({
          id: card.id || item.card_id,
          nom: card.wikipedia_title || 'Sans titre',
          rarete: card.rarity || 'NC',
          exemplaires: item.count || 1,
          prixWB: null,
          statut: 'En attente'
        });
      }

      page++;
      await sleep(60);
    } catch (e) {
      break;
    }
  }

  console.log("%c[WikiMasters] ✅ " + allCards.length + " cartes récupérées.", "color: #00ff88; font-weight: bold;");
  console.log("%c[WikiMasters] 2/3 Interrogation des prix marché...", "color: #00d2ff; font-weight: bold;");

  const batchSize = 25;
  for (let i = 0; i < allCards.length; i += batchSize) {
    const batch = allCards.slice(i, i + batchSize);

    await Promise.all(batch.map(async (card) => {
      if (!card.id) return;
      try {
        const res = await fetch('/api/marketplace/cards/' + card.id + '/sales?scope=summary');
        if (res.ok) {
          const sales = await res.json();
          const summary = sales.summary || {};
          const rarityStats = summary[card.rarete] || Object.values(summary)[0];
          const avg = rarityStats ? rarityStats.average : null;

          if (avg && avg > 0) {
            card.prixWB = Math.round(avg);
            card.statut = card.prixWB + ' WB';
          } else {
            card.statut = 'Aucune vente';
          }
        } else {
          card.statut = 'Pas de données';
        }
      } catch (err) {
        card.statut = 'Erreur API';
      }
    }));

    if (i % 200 === 0 || i + batchSize >= allCards.length) {
      console.log('Progression : ' + Math.min(i + batchSize, allCards.length) + ' / ' + allCards.length);
    }
    await sleep(80);
  }

  allCards.sort((a, b) => (b.prixWB || 0) - (a.prixWB || 0));
  window.__CARDS__ = allCards;

  console.log("%c[WikiMasters] 3/3 Téléchargement du CSV...", "color: #00d2ff; font-weight: bold;");

  const bom = '\uFEFF';
  let csv = bom + "Rareté;Nom;Exemplaires;Prix Moyen (WB);Valeur Totale (WB);Statut;ID\n";

  for (const c of allCards) {
    const nomClean = String(c.nom || '').replace(/"/g, '""');
    const prix = c.prixWB !== null && c.prixWB !== undefined ? c.prixWB : '';
    const valTotale = c.prixWB !== null && c.prixWB !== undefined ? (c.prixWB * c.exemplaires) : '';
    const statut = String(c.statut || '');
    const id = String(c.id || '');

    csv += '"' + c.rarete + '";"' + nomClean + '";' + c.exemplaires + ';' + prix + ';' + valTotale + ';"' + statut + '";"' + id + '"\n';
  }

  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'wikimasters_collection_' + new Date().toISOString().slice(0, 10) + '.csv';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);

  console.log("%c[WikiMasters] ✅ Téléchargement terminé !", "color: #00ff88; font-weight: bold;");
})();
