(async () => {
  const sleep = ms => new Promise(r => setTimeout(r, ms));
  const allCards = [];
  let page = 0;
  let hasMore = true;

  console.log("%c[WikiMasters] 1/2 Récupération de l'inventaire via l'API...", "color: #00d2ff; font-weight: bold;");

  // 1. Aspiration directe via l'API de collection
  while (hasMore) {
    try {
      const res = await fetch(`/api/my-collection?sort=rarity&page=${page}&stats=0`);
      if (!res.ok) break;

      const data = await res.json();
      const list = data.collection || [];

      if (list.length === 0) {
        hasMore = false;
        break;
      }

      for (const item of list) {
        const card = item.card || {};
        allCards.push({
          id: card.id || item.card_id,
          nom: card.wikipedia_title || 'Sans titre',
          rarete: card.rarity || 'NC',
          exemplaires: item.count || 1,
          prixWB: null,
          statut: 'En attente'
        });
      }

      console.log(`Page \({page} chargée (\){allCards.length} cartes collectées)...`);
      page++;
      await sleep(80); // Court délai de courtoisie
    } catch (e) {
      console.error(`Erreur sur la page ${page}:`, e);
      break;
    }
  }

  console.log(`%c[WikiMasters] ✅ Total : ${allCards.length} cartes.`, "color: #00ff88; font-weight: bold;");
  console.log("%c[WikiMasters] 2/2 Récupération des prix moyens sur le marché...", "color: #00d2ff; font-weight: bold;");

  // 2. Récupération des prix moyens par lots de 25
  const batchSize = 25;
  for (let i = 0; i < allCards.length; i += batchSize) {
    const batch = allCards.slice(i, i + batchSize);

    await Promise.all(batch.map(async (card) => {
      if (!card.id) return;
      try {
        const res = await fetch(`/api/marketplace/cards/${card.id}/sales?scope=summary`);
        if (res.ok) {
          const sales = await res.json();
          const avg = sales.averagePrice ?? sales.average ?? sales.avg ?? sales.summary?.averagePrice;
          
          if (avg && avg > 0) {
            card.prixWB = Math.round(avg);
            card.statut = `${card.prixWB} WB`;
          } else {
            card.statut = 'Aucune vente';
          }
        } else {
          card.statut = 'Pas de données';
        }
      } catch (err) {
        card.statut = 'Erreur API';
      }
    }));

    console.log(`Progression prix : \({Math.min(i + batchSize, allCards.length)} /\){allCards.length}`);
    await sleep(100); // Évite de déclencher le rate limiting
  }

  // 3. Tri du plus cher au moins cher et affichage
  allCards.sort((a, b) => (b.prixWB || 0) - (a.prixWB || 0));

  const totalValue = allCards.reduce((acc, c) => acc + (c.prixWB || 0) * c.exemplaires, 0);
  console.log(`%c[WikiMasters] 💰 Valeur totale estimée : ${totalValue.toLocaleString('fr-FR')} WB`, "color: #ffaa00; font-weight: bold; font-size: 14px;");

  console.table(allCards.map(c => ({
    Rareté: c.rarete,
    Nom: c.nom,
    Exemplaires: c.exemplaires,
    'Prix Moyen': c.prixWB !== null ? `${c.prixWB} WB` : c.statut,
    ID: c.id
  })));

  // Expose le résultat directement dans la console pour manipulation libre (ex: copy(window.__CARDS__))
  window.__CARDS__ = allCards;
  console.log("👉 Données brutes disponibles dans la variable : window.__CARDS__");
})();
