(async function() {
  var sleep = function(ms) {
    return new Promise(function(resolve) { setTimeout(resolve, ms); });
  };
  var duplicates = [];
  var page = 0;
  var totalPages = null;

  // 1. Interface graphique
  var ui = document.createElement("div");
  ui.id = "wm-scanner-ui";
  Object.assign(ui.style, {
    position: "fixed",
    top: "20px",
    right: "20px",
    zIndex: "999999",
    width: "320px",
    padding: "16px",
    backgroundColor: "rgba(18, 18, 24, 0.95)",
    backdropFilter: "blur(8px)",
    border: "1px solid #334155",
    borderRadius: "12px",
    boxShadow: "0 10px 25px rgba(0, 0, 0, 0.5)",
    fontFamily: "system-ui, -apple-system, sans-serif",
    color: "#f8fafc",
    fontSize: "13px"
  });

  var header = document.createElement("div");
  Object.assign(header.style, {
    display: "flex",
    justifyContent: "space-between",
    alignItems: "center",
    marginBottom: "8px"
  });

  var title = document.createElement("span");
  title.style.fontWeight = "700";
  title.style.color = "#ff9800";
  title.textContent = "Scan des doublons";

  var percentLabel = document.createElement("span");
  percentLabel.style.fontWeight = "700";
  percentLabel.style.color = "#38bdf8";
  percentLabel.textContent = "0%";

  header.appendChild(title);
  header.appendChild(percentLabel);
  ui.appendChild(header);

  var statusLabel = document.createElement("div");
  Object.assign(statusLabel.style, {
    fontSize: "11px",
    color: "#94a3b8",
    marginBottom: "8px",
    whiteSpace: "nowrap",
    overflow: "hidden",
    textOverflow: "ellipsis"
  });
  statusLabel.textContent = "Démarrage...";
  ui.appendChild(statusLabel);

  var track = document.createElement("div");
  Object.assign(track.style, {
    width: "100%",
    height: "8px",
    backgroundColor: "#334155",
    borderRadius: "4px",
    overflow: "hidden"
  });

  var bar = document.createElement("div");
  Object.assign(bar.style, {
    width: "0%",
    height: "100%",
    background: "linear-gradient(90deg, #ff9800, #00d2ff)",
    transition: "width 0.2s ease"
  });

  track.appendChild(bar);
  ui.appendChild(track);
  document.body.appendChild(ui);

  var updateProgress = async function(percent, statusText) {
    var clamped = Math.min(100, Math.max(0, Math.round(percent)));
    bar.style.width = clamped + "%";
    percentLabel.textContent = clamped + "%";
    statusLabel.textContent = statusText;
    await new Promise(requestAnimationFrame);
  };

  var closeUI = function(delay) {
    setTimeout(function() {
      ui.style.transition = "opacity 0.4s ease";
      ui.style.opacity = "0";
      setTimeout(function() { ui.remove(); }, 400);
    }, delay || 4000);
  };

  // 2. Inventaire (de 0% à 30%)
  await updateProgress(2, "Interrogation de la collection...");

  while (true) {
    try {
      var res = await fetch("/api/my-collection?sort=rarity&page=" + page + "&stats=0");
      if (!res.ok) break;

      var data = await res.json();
      var list = data.collection || [];

      if (totalPages === null && data.totalPages) {
        totalPages = data.totalPages;
      }

      if (list.length === 0) break;

      for (var i = 0; i < list.length; i++) {
        var item = list[i];
        var card = item.card || {};
        var count = item.count || 1;

        if (count > 1) {
          duplicates.push({
            id: card.id || item.card_id,
            nom: card.wikipedia_title || "Sans titre",
            rarete: card.rarity || "NC",
            exemplaires: count,
            doublons: count - 1,
            prixWB: null,
            statut: "En attente"
          });
        }
      }

      page++;
      var scanPercent = totalPages ? Math.round((page / totalPages) * 30) : Math.min(28, page * 2);
      await updateProgress(scanPercent, "Inventaire : page " + page + (totalPages ? "/" + totalPages : "") + " (" + duplicates.length + " doublons)");

      if (totalPages && page >= totalPages) break;
      await sleep(40);
    } catch (err) {
      console.error("[WikiMasters] Erreur collection :", err);
      break;
    }
  }

  if (duplicates.length === 0) {
    await updateProgress(100, "Aucun doublon trouvé.");
    console.log("%c[WikiMasters] Aucun doublon détecté.", "color: #4caf50; font-weight: bold;");
    closeUI(3000);
    return;
  }

  // 3. Prix du marché (de 30% à 95%)
  var batchSize = 25;
  var total = duplicates.length;

  for (var j = 0; j < total; j += batchSize) {
    var batch = duplicates.slice(j, j + batchSize);

    await Promise.all(
      batch.map(async function(card) {
        if (!card.id) return;
        try {
          var sRes = await fetch("/api/marketplace/cards/" + card.id + "/sales?scope=summary");
          if (sRes.ok) {
            var sales = await sRes.json();
            var summary = sales.summary || {};
            var rarityStats = summary[card.rarete] || Object.values(summary)[0];
            var avg = rarityStats ? rarityStats.average : null;

            if (avg && avg > 0) {
              card.prixWB = Math.round(avg);
              card.statut = card.prixWB + " WB";
            } else {
              card.statut = "Aucune vente";
            }
          } else {
            card.statut = "Pas de données";
          }
        } catch (e) {
          card.statut = "Erreur API";
        }
      })
    );

    var processed = Math.min(j + batchSize, total);
    var progress = 30 + Math.round((processed / total) * 65);
    await updateProgress(progress, "Prix marché : " + processed + " / " + total);
    await sleep(60);
  }

  // 4. Tri et affichage console
  duplicates.sort(function(a, b) {
    return (b.doublons - a.doublons) || ((b.prixWB || 0) - (a.prixWB || 0));
  });

  window.mesDoublons = duplicates;

  console.table(
    duplicates.map(function(c) {
      return {
        "Nom": c.nom,
        "Rareté": c.rarete,
        "Total": c.exemplaires,
        "En trop": c.doublons,
        "Prix Moyen": c.prixWB !== null ? (c.prixWB + " WB") : "N/A",
        "Valeur Doublons": c.prixWB !== null ? ((c.prixWB * c.doublons) + " WB") : "N/A"
      };
    })
  );

  // 5. Export CSV (95% -> 100%)
  await updateProgress(98, "Génération du fichier CSV...");

  var lines = [];
  lines.push(["Rareté", "Nom", "Exemplaires Totaux", "Doublons Vendables", "Prix Moyen Unitaire (WB)", "Valeur Totale des Doublons (WB)", "Statut Marché", "ID"]);

  for (var k = 0; k < duplicates.length; k++) {
    var c = duplicates[k];
    var valTotale = c.prixWB !== null ? (c.prixWB * c.doublons) : "";
    lines.push([
      c.rarete,
      c.nom,
      c.exemplaires,
      c.doublons,
      c.prixWB !== null ? c.prixWB : "",
      valTotale,
      c.statut,
      c.id
    ]);
  }

  var csvContent = "\uFEFF" + lines.map(function(row) {
    return row.map(function(cell) {
      return '"' + String(cell).replace(/"/g, '""') + '"';
    }).join(";");
  }).join("\r\n");

  var blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
  var url = URL.createObjectURL(blob);
  var link = document.createElement("a");
  link.href = url;
  link.download = "wikimasters_doublons_" + new Date().toISOString().slice(0, 10) + ".csv";
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  URL.revokeObjectURL(url);

  await updateProgress(100, "Téléchargement terminé !");
  console.log("%c[WikiMasters] Succès ! Fichier CSV exporté.", "color: #00ff88; font-weight: bold;");
  closeUI(5000);
})();
